# Real Estate Price Prediction Engine — Example Environment File
# Copy to .env and configure as needed for local or production execution.

# Application Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production

# CORS Allowed Origins (Comma separated, e.g. https://realestate-ml.org,https://app.realestate-ml.org)
CORS_ORIGINS=*

# External API Timeout & Retry Settings
REQUEST_TIMEOUT=5.0
MAX_RETRIES=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
